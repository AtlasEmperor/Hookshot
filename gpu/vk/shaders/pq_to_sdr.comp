#version 450
// (hookshot) The game's picture in PQ (ST 2084, Rec. 2020) that goes to an SDR window: the game was told its display is HDR10
// and has not asked again since the window fell back to SDR. Paper white is the picture's white; what is brighter is brought
// back to white keeping its hue. Scaled from its crop as the blit was. The inverse of hdr_encode.comp's PQ and primaries.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    vec4 uv;       // the source's crop: x0, y0, x1, y1 (0 to 1)
    float white;   // paper white, nits
} pc;
vec3 pq_to_nits(vec3 code) {
    const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
    const vec3 p = pow(clamp(code, 0.0, 1.0), vec3(1.0 / m2));
    return 10000.0 * pow(max(p - c1, 0.0) / (c2 - c3 * p), vec3(1.0 / m1));
}
vec3 linear_to_srgb(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, greaterThan(c, vec3(0.0031308)));
}
void main() {
    const ivec2 size = imageSize(dst);
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= size.x || at.y >= size.y) return;
    const vec2 t = (vec2(at) + 0.5) / vec2(size);
    const vec3 nits = pq_to_nits(textureLod(src, mix(pc.uv.xy, pc.uv.zw, t), 0.0).rgb);
    // (Rec. 2020 primaries to Rec. 709's, ITU-R BT.2087)
    const mat3 to709 = mat3(1.6605, -0.1246, -0.0182, -0.5876, 1.1329, -0.1006, -0.0728, -0.0083, 1.1187);
    const vec3 lin = max(to709 * nits / pc.white, vec3(0.0));
    const vec3 shown = lin / max(1.0, max(lin.r, max(lin.g, lin.b)));
    imageStore(dst, at, vec4(linear_to_srgb(shown), 1.0));
}
